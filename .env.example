# RAG service API base URL. The API key is read by Express only, never by Vite frontend.
# Uses /knowledge/index, /knowledge/{id}, and /extract under this base URL.
RAG_API_URL="https://rag.aiones.app/api/v1"
RAG_API_KEY=""

# Authentication format can be adjusted to match the RAG server.
# For X-API-Key authentication, set RAG_API_AUTH_HEADER="X-API-Key" and the prefix to empty.
RAG_API_AUTH_HEADER="Authorization"
RAG_API_AUTH_PREFIX="Bearer"

# Port for the optional standalone API server and npm start.
# npm run dev serves the frontend and Study Coach API together on port 3000.
PORT=3001
